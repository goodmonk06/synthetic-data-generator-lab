// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GenerationProfile {
  id               String           @id @default(uuid())
  name             String
  sourceType       SourceType
  sourceSchemaJson Json             // Store the parsed schema (table structure or JSON schema)
  rulesJson        Json             // Generation rules for each field
  rowCount         Int              @default(100)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  runs             GenerationRun[]

  @@map("generation_profiles")
}

model GenerationRun {
  id        String            @id @default(uuid())
  profileId String
  profile   GenerationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  startedAt DateTime          @default(now())
  finishedAt DateTime?
  status    RunStatus         @default(PENDING)
  outputPath String?
  rowsGenerated Int?
  errorMessage String?

  @@map("generation_runs")
}

enum SourceType {
  RDB
  JSON
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
